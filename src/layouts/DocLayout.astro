---
import { Icon } from 'astro-icon/components';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Footer from '~/components/Footer.astro';
import { SITE, DEFAULT_LOCALE, localizedPath, alternatesFor, ui, type Locale } from '~/i18n';
import Media from '~/components/Media.astro';
import { mediaJsonLd, type MediaItem } from '~/lib/media';

interface Crumb {
  label: string;
  path?: string; // locale-relative; omit for the current page
}

interface Props {
  lang: Locale;
  /** Locale-relative path of THIS page, e.g. "/errors/foo". */
  path: string;
  /** Declared by the page's frontmatter; see src/lib/media-schema.ts. */
  media?: MediaItem[];
  title: string;
  /** The <title> text, when it should say more than the breadcrumb label. */
  headTitle?: string;
  description: string;
  breadcrumbs?: Crumb[];
  /** True only where the page describes CertMate itself; see BaseLayout. */
  product?: boolean;
}

const { lang, path, title, headTitle, description, breadcrumbs = [], media = [], product = false } = Astro.props;
const t = ui[lang];
const canonical = SITE + localizedPath(lang, path);
const alternates = alternatesFor(path);
const otherLocale: Locale = lang === 'en' ? 'it' : 'en';

const fullTitle = `${headTitle ?? title} · CertMate`;

// BreadcrumbList structured data.
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { label: t.home, path: '/' },
    ...breadcrumbs,
    { label: title },
  ].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(('path' in c && c.path) ? { item: SITE + localizedPath(lang, c.path) } : {}),
  })),
};
---

<BaseLayout
  title={fullTitle}
  description={description}
  canonical={canonical}
  lang={lang}
  alternates={alternates}
  product={product}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(crumbLd)}
  />
  {media.map((item) => (
    <script
      is:inline
      slot="head"
      type="application/ld+json"
      set:html={JSON.stringify(mediaJsonLd(item, SITE, canonical))}
    />
  ))}

  <header class="sticky top-0 z-40 border-b border-gray-200 bg-white/80 backdrop-blur dark:border-gray-800 dark:bg-gray-900/80">
    <div class="mx-auto flex max-w-container items-center justify-between gap-4 px-4 py-3">
      <a href={localizedPath(lang, '/')} class="flex items-center gap-2 font-semibold text-gray-900 dark:text-white">
        <img src="/assets/certmate_logo.png" alt="CertMate" width="28" height="28" />
        <span>CertMate</span>
      </a>
      <div class="flex items-center gap-3 text-sm">
        <a href={localizedPath(lang, '/errors')} class="text-gray-600 hover:text-primary dark:text-gray-300">{t.errors}</a>
        <a href={localizedPath(lang, '/deploy')} class="text-gray-600 hover:text-primary dark:text-gray-300">{t.deploy}</a>
        <a
          href={localizedPath(otherLocale, path)}
          class="rounded border border-gray-300 px-2 py-1 font-medium uppercase text-gray-600 hover:border-primary hover:text-primary dark:border-gray-700 dark:text-gray-300"
          aria-label={otherLocale === 'it' ? 'Italiano' : 'English'}
        >{otherLocale}</a>
      </div>
    </div>
  </header>

  {/* overflow-wrap:anywhere, not break-words: error codes such as
     MOZILLA_PKIX_ERROR_CA_CERT_USED_AS_END_ENTITY are one 45-character token,
     and only `anywhere` lets the breadcrumb, the prose and the index grid
     shrink below it. Measured at 390px, three pages scrolled sideways.

     It applies to code and to the breadcrumb, where those tokens are, and not
     to the whole of main. On main it also lowered the minimum width of every
     table cell to one character, and the comparison table broke words at
     1440px: "Kubernet-es", "Dashboa-rd". */}
  <main id="main-content" class="mx-auto w-full max-w-3xl flex-1 px-4 py-8 [&_:is(code,.font-mono)]:[overflow-wrap:anywhere]">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-gray-500 [overflow-wrap:anywhere] dark:text-gray-400">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href={localizedPath(lang, '/')} class="hover:text-primary">{t.home}</a></li>
        {breadcrumbs.map((c) => (
          <li class="flex items-center gap-1">
            <span aria-hidden="true">/</span>
            {c.path
              ? <a href={localizedPath(lang, c.path)} class="hover:text-primary">{c.label}</a>
              : <span>{c.label}</span>}
          </li>
        ))}
        <li class="flex items-center gap-1">
          <span aria-hidden="true">/</span>
          <span class="text-gray-700 dark:text-gray-200">{title}</span>
        </li>
      </ol>
    </nav>

    <article class="prose prose-slate max-w-none dark:prose-invert prose-headings:scroll-mt-24 prose-pre:bg-gray-900 prose-pre:text-gray-100 prose-a:text-primary">
      <slot />
      <Media items={media} />
    </article>

    <aside class="not-prose mt-12 rounded-xl border border-primary-100 bg-primary-50 p-6 dark:border-primary-900/40 dark:bg-primary-900/10">
      <h2 class="mb-1 text-lg font-semibold text-gray-900 dark:text-white">{t.automateCta}</h2>
      <p class="mb-4 text-sm text-gray-600 dark:text-gray-300">{t.automateBody}</p>
      <div class="flex flex-wrap gap-3">
        <a href="https://github.com/fabriziosalmi/certmate" class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700">
          <Icon name="fa6-brands:github" /> {t.automateBtn}
        </a>
        <a href={t.docsHref} class="inline-flex items-center gap-2 rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:border-primary hover:text-primary dark:border-gray-700 dark:text-gray-200">
          {t.docsBtn}
        </a>
      </div>
    </aside>
  </main>

  <Footer />
</BaseLayout>
