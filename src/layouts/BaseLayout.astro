---
import '~/styles/global.css';
import { VERSION, PROVIDER_COUNT, GITHUB } from '~/data/site';
import { ogImageFor } from '~/lib/og';

interface Alternate {
  hreflang: string; // 'en' | 'it' | 'x-default'
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  lang?: string;
  /** hreflang alternates for this URL across locales. */
  alternates?: Alternate[];
  /**
   * Whether this page describes CertMate itself, and so carries the
   * SoftwareApplication block. Off by default: see the note above ldJson.
   */
  product?: boolean;
}

const {
  lang = 'en',
  alternates = [],
  product = false,
  // Title preserved verbatim from the previous static index.html so
  // search signal carries over. Description stays under Google's ~155
  // truncation cap and leads with the differentiators (verifiable audit
  // trail, provider count, OIDC, REST API + CLI, license, version) —
  // version and provider count come from ~/data/site so they never drift.
  // ogImage defaults to this page's own 1200x630 card rather than to one
  // image for the whole site: a shared link to an error page used to show
  // the product's front-door card. The file is drawn by
  // `node scripts/build-og.mjs` from this page's <title> after the build,
  // and scripts/check-seo.mjs fails if the file a page asks for is missing.
  title = 'CertMate - SSL Certificate Management System',
  description = `Self-hosted TLS certificate management with a tamper-evident, verifiable audit trail. ${PROVIDER_COUNT} DNS providers, OIDC/SSO, REST API + CLI. MIT licensed. v${VERSION}.`,
  canonical = 'https://www.certmate.org/',
  ogImage = ogImageFor(Astro.url.pathname),
} = Astro.props;

// This block describes CertMate, so it belongs on the pages that describe
// CertMate and nowhere else. It used to be emitted by this layout on all 30
// pages it renders, which put "this page is a software application, free,
// MIT, 29 DNS providers" on an SSL error explanation, a deployment guide and
// the privacy notice. Google's structured data guidelines are explicit about
// both halves of that: "Put the structured data on the page that it
// describes" and "Your structured data must be a true representation of the
// page content".
//
// It is kept, unchanged, on the pages where it is true: the two home pages
// and the two comparison pages, which show CertMate's features in their own
// visible body.
//
// It is worth being honest about what it buys. Google's Software App
// documentation requires name, offers.price, and one of aggregateRating or
// review. This project has no ratings and will not invent any, so no page
// here is eligible for the Software App rich result, and none was before
// either. The block stays because it describes the entity accurately, not
// because it is expected to draw stars.
const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CertMate',
  description: `CertMate issues and renews TLS certificates across ${PROVIDER_COUNT} DNS providers and records every action in a tamper-evident, independently verifiable audit trail. Self-hosted and MIT-licensed, with OIDC/SSO, a REST API and a terminal CLI.`,
  url: 'https://www.certmate.org/',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, Windows, macOS',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  softwareVersion: VERSION,
  license: 'https://opensource.org/licenses/MIT',
  featureList: [
    'OIDC / SSO authentication',
    'ACME / Let\'s Encrypt automation',
    `${PROVIDER_COUNT} DNS providers`,
    'Tamper-evident, independently verifiable audit trail',
    'Private CA + mTLS / client certificates',
    'Encrypted Windows .pfx (PKCS#12) export',
    'REST API + RBAC + scoped API keys',
    'Terminal SDK + CLI (pip install certmate-cli)',
    'Docker / Kubernetes deployment',
  ],
  author: {
    '@type': 'Person',
    name: 'Fabrizio Salmi',
    url: 'https://github.com/fabriziosalmi',
  },
  codeRepository: GITHUB,
  programmingLanguage: 'Python',
  runtimePlatform: 'Docker',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- hreflang alternates: tell search engines about the localized
         variants of this URL so the right language ranks per market. -->
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}

    <!-- Enhanced SEO Meta Tags — preserved from the static site. -->
    <meta name="author" content="Fabrizio Salmi" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="canonical" href={canonical} />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />

    <!-- Structured data: only where it describes this page. -->
    {product && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(ldJson)}
      />
    )}

    <!-- Per-page <head> extras (extra structured data, etc.) -->
    <slot name="head" />

    <meta name="description" content={description} />
    <!-- No meta keywords. It was one identical line on all 30 rendered pages,
         and no search engine has used it for well over a decade. -->

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Card tags, on name= rather than property=. property= is the Open
         Graph spelling; the card documentation specifies name=, and most
         parsers accept the other only as a fallback. Nothing observable was
         broken, which is why this sat here: it is a conformance fix, and no
         ranking effect is claimed for it. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon: the brand PNG resized into the sizes browsers actually pick
         up. The previous static site referenced a generic Font Awesome
         shield SVG that did not match the brand at all. Modern browsers
         prefer the largest <link rel="icon"> that fits, so listing both
         32 and 192 lets a desktop tab pull the small one and an Android
         homescreen the large one. apple-touch-icon stays 180px (the iOS
         standard). -->
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />

    <!-- Inter is self-hosted via @fontsource/inter (imported in
         src/styles/global.css). Font Awesome was replaced by astro-icon
         (inline SVGs at build, only the icons we use). Both changes
         eliminate the two render-blocking cross-origin stylesheets
         this page used to ship. JetBrains Mono is only needed in the
         terminal-demo block; deferred to a lazy load so it does not
         block first paint. -->

    <!-- Dark-mode FOUC fix: apply the stored choice (or system preference)
         before the first paint. -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = stored ? stored === 'dark' : prefersDark;
          if (isDark) document.documentElement.classList.add('dark');
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
  </body>
</html>
