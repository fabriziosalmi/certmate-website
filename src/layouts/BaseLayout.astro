---
import '~/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  // Title preserved verbatim from the previous static index.html so
  // search signal carries over. Description rewritten to 124 chars
  // (under Google's ~155 truncation cap) and carrying the actual
  // differentiators: provider count, OIDC, REST API, license, version.
  // ogImage swapped from the logo-only PNG to a 1200×630 social card
  // generated by `node scripts/build-og.mjs`.
  title = 'CertMate - SSL Certificate Management System',
  description = 'Open-source SSL certificate management with 24 DNS providers, OIDC/SSO, REST API and Docker. MIT licensed. v2.8.0.',
  canonical = 'https://www.certmate.org/',
  ogImage = 'https://www.certmate.org/assets/og.png',
} = Astro.props;

// The previous index.html shipped this structured-data block verbatim;
// keep the same shape so SoftwareApplication rich-result eligibility
// carries over without re-indexing.
const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CertMate',
  description: 'A powerful SSL certificate management system designed for modern infrastructure. Built with multi-DNS provider support, Docker containerization, and comprehensive REST API.',
  url: 'https://www.certmate.org/',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, Windows, macOS',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: {
    '@type': 'Person',
    name: 'Fabrizio Salmi',
    url: 'https://github.com/fabriziosalmi',
  },
  codeRepository: 'https://github.com/fabriziosalmi/certmate',
  programmingLanguage: 'Python',
  runtimePlatform: 'Docker',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Enhanced SEO Meta Tags — preserved from the static site. -->
    <meta name="author" content="Fabrizio Salmi" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="canonical" href={canonical} />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />

    <!-- Structured data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(ldJson)}
    />

    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="SSL certificates, Let's Encrypt, certificate management, Docker, API, multi-DNS provider, automation, RBAC, private CA, ACME"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Favicon: the brand PNG resized into the sizes browsers actually pick
         up. The previous static site referenced a generic Font Awesome
         shield SVG that did not match the brand at all. Modern browsers
         prefer the largest <link rel="icon"> that fits, so listing both
         32 and 192 lets a desktop tab pull the small one and an Android
         homescreen the large one. apple-touch-icon stays 180px (the iOS
         standard). -->
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />

    <!-- Inter is self-hosted via @fontsource/inter (imported in
         src/styles/global.css). Font Awesome was replaced by astro-icon
         (inline SVGs at build, only the icons we use). Both changes
         eliminate the two render-blocking cross-origin stylesheets
         this page used to ship. JetBrains Mono is only needed in the
         terminal-demo block; deferred to a lazy load so it does not
         block first paint. -->

    <!-- Dark-mode FOUC fix: apply the stored choice (or system preference)
         before the first paint. -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = stored ? stored === 'dark' : prefersDark;
          if (isDark) document.documentElement.classList.add('dark');
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
  </body>
</html>
