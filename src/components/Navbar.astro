---
import { Icon } from 'astro-icon/components';
// Section anchors are absolute (/#features …) so they resolve to the
// homepage section from any page (e.g. /security), not just a same-page
// hash. External links that point to certmate.org/#features keep landing
// where they did pre-migration. /security is a standalone page.
const links = [
  { href: '/#features', label: 'Features' },
  { href: '/#providers', label: 'DNS Providers' },
  { href: '/#installation', label: 'Installation' },
  { href: '/#api', label: 'API' },
  { href: '/security', label: 'Security' },
  { href: '/#docs', label: 'Documentation' },
];

// Sister projects in the CertMate ecosystem. External links open in a new
// tab; flagged with `external: true` so the menu renderer can attach the
// noopener/noreferrer rels and a small "↗" affordance for screen readers
// AND sighted users.
const ecosystem = [
  { href: 'https://agent.certmate.org', label: 'Agent', external: true },
  { href: 'https://tools.certmate.org', label: 'Tools', external: true },
];
---

<nav
  class="sticky top-0 z-40 border-b border-gray-200 bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/60 dark:border-gray-800 dark:bg-gray-950/80 dark:supports-[backdrop-filter]:bg-gray-950/60"
  role="navigation"
  aria-label="Main navigation"
>
  <div class="container-x flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2.5" aria-label="CertMate home">
      <!-- Logo at 40px renders crisp on the 64px nav strip without dwarfing
           the brand text alongside it. The previous 32px size felt
           anaemic on retina displays. width/height attrs match the
           rendered size so the browser does not need to reflow on
           load. -->
      <img
        src="/assets/certmate_logo.png"
        alt="CertMate logo"
        class="h-10 w-10"
        width="40"
        height="40"
        loading="eager"
        decoding="async"
      />
      <span class="text-lg font-bold tracking-tight">CertMate</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex" id="nav-menu">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      {/* Sister-project links: separated from the in-page anchors above
         with a thin vertical rule so a sighted user can tell which links
         leave the current site without having to read the ↗ marker. */}
      <li aria-hidden="true" class="h-5 w-px bg-gray-200 dark:bg-gray-700 mx-1" />
      {
        ecosystem.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white"
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label}
              <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.65rem] opacity-60" aria-hidden="true" />
              <span class="sr-only">(opens in new tab)</span>
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="https://github.com/fabriziosalmi/certmate"
          class="inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="fa6-brands:github" aria-hidden="true" />
          GitHub
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </li>
    </ul>

    <div class="flex items-center gap-2">
      <!-- Theme toggle: pure-CSS-class flip wired through localStorage. -->
      <button
        id="theme-toggle"
        type="button"
        class="rounded-md p-2 text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white"
        aria-label="Toggle color theme"
      >
        <Icon name="fa6-solid:sun" class="hidden dark:inline" aria-hidden="true" />
        <Icon name="fa6-solid:moon" class="inline dark:hidden" aria-hidden="true" />
      </button>

      <button
        id="nav-hamburger"
        type="button"
        class="rounded-md p-2 text-gray-600 hover:bg-gray-100 md:hidden dark:text-gray-300 dark:hover:bg-gray-800"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="nav-menu-mobile"
      >
        <Icon name="fa6-solid:bars" class="text-lg" aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="nav-menu-mobile"
    class="hidden border-t border-gray-200 bg-white md:hidden dark:border-gray-800 dark:bg-gray-950"
  >
    <ul class="container-x flex flex-col gap-1 py-3">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li aria-hidden="true" class="my-1 h-px bg-gray-200 dark:bg-gray-700 mx-3" />
      {
        ecosystem.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800"
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label}
              <Icon name="fa6-solid:arrow-up-right-from-square" class="ml-1 text-[0.65rem] opacity-60" aria-hidden="true" />
              <span class="sr-only">(opens in new tab)</span>
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="https://github.com/fabriziosalmi/certmate"
          class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="fa6-brands:github" class="mr-1" aria-hidden="true" /> GitHub
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  // Theme toggle: persist user choice in localStorage; the FOUC-prevention
  // inline script in BaseLayout reads the same key.
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const html = document.documentElement;
    const next = html.classList.toggle('dark') ? 'dark' : 'light';
    try {
      localStorage.setItem('theme', next);
    } catch (_) {}
  });

  // Mobile-menu disclosure.
  const burger = document.getElementById('nav-hamburger');
  const mobile = document.getElementById('nav-menu-mobile');
  burger?.addEventListener('click', () => {
    const open = mobile?.classList.toggle('hidden') === false;
    burger.setAttribute('aria-expanded', String(open));
  });

  // Auto-close the mobile menu after the user taps a link — otherwise the
  // disclosure stays open over the destination section and the user has
  // to tap the hamburger again to dismiss it.
  mobile?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobile.classList.add('hidden');
      burger?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
