---
import { Icon } from 'astro-icon/components';
import { COMPARE_CHECKED, HOME_VIEW, compareTable } from '~/data/compare';
/**
 * Honest comparison vs the tools a CertMate evaluator most often comes
 * from: cert-manager (Kubernetes-native, the de-facto k8s certificate
 * controller), Caddy auto-HTTPS (bundled webserver path), acme.sh /
 * lego (shell-script / Go CLI tools), and Certbot directly. The point
 * is not to claim CertMate is better at everything (it isn't — Caddy is
 * lower-friction if you're already serving with it; cert-manager is
 * the right answer for a multi-Ingress k8s cluster). The point is to
 * make the decision space readable so a visitor figures out in 15
 * seconds whether to keep reading or close the tab.
 *
 * Rules for entries: every cell is a fact (not a marketing claim).
 * "Yes" / "No" / "Partial" / a short clarifier in parentheses. The cells
 * live in src/data/compare.ts, which the comparison pages read too.
 */

const table = compareTable(HOME_VIEW, 'en');

// Cell styling — "Yes" gets the affirmative tint, "No" the muted tint,
// everything else (Partial, clarifiers) renders neutral. The cell-type
// detection is loose-string-match because the cell content is short
// and English-anchored; sufficient for what this table conveys.
function cellTint(v: string): string {
  const t = v.trim().toLowerCase();
  if (t === 'yes' || t.startsWith('yes ')) {
    return 'text-emerald-700 dark:text-emerald-400 font-medium';
  }
  if (t === 'no' || t.startsWith('no ')) {
    // gray-400 on white was 2.5:1, which Lighthouse flagged; gray-500 is 4.8:1.
    return 'text-gray-500 dark:text-gray-400';
  }
  return 'text-gray-700 dark:text-gray-300';
}
---

<section id="comparison" class="border-b border-gray-200 py-20 dark:border-gray-800" aria-labelledby="comparison-title">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="comparison-title" class="section-title">
        How does CertMate compare?
      </h2>
      <p class="section-description">
        Pick the tool that matches your environment. CertMate is the right
        answer when you want a web UI + REST API + many DNS providers
        outside Kubernetes; cert-manager wins inside a Kubernetes cluster;
        Caddy is the lowest-friction choice if you're already serving HTTP
        with it.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-5xl overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-800">
      <table class="w-full text-left text-sm">
        <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500 dark:bg-gray-900 dark:text-gray-400">
          <tr>
            <th scope="col" class="px-4 py-3">Feature</th>
            {table.columns.map((c, i) => (
              <th scope="col" class={`px-4 py-3 ${i === 0 ? 'text-primary' : ''}`}>{c}</th>
            ))}
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
          {
            table.rows.map((r) => (
              <tr class="bg-white dark:bg-gray-950">
                <th scope="row" class="px-4 py-3 font-medium text-gray-900 dark:text-white">
                  {r.label}
                </th>
                {r.cells.map((cell) => (
                  <td class={`px-4 py-3 ${cellTint(cell)}`}>{cell}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mx-auto mt-6 max-w-3xl text-center text-xs text-gray-500 dark:text-gray-400">
      {COMPARE_CHECKED.en}
    </p>
  </div>
</section>
