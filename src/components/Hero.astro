---
import { Icon } from 'astro-icon/components';
import { VERSION, PROVIDER_COUNT, GITHUB } from '~/data/site';

// Hero leads with substance, not adjectives: what CertMate is, and the one
// thing that sets it apart — an independently verifiable audit trail. The
// version and provider count come from ~/data/site so the badge can never
// drift from the rest of the page again.
//
// The right-hand visual is a static, clearly-illustrative certmate-cli
// transcript. It replaces the previous SIMULATED terminal that printed
// invented output ("CertMate started successfully", a made-up certificate
// for a made-up host) as if it were real — which flatly contradicted the
// project's "truth in reporting" posture. The commands below are the actual
// certmate-cli subcommands (clients/certmate-cli); the result lines are
// schematic examples, not a captured run.
---

<section
  class="relative overflow-hidden border-b border-gray-200 dark:border-gray-800"
  aria-labelledby="hero-title"
>
  <!-- Soft background so the rest of the page can stay white/dark cleanly. -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-br from-blue-50 via-white to-cyan-50 dark:from-gray-950 dark:via-gray-950 dark:to-gray-900"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,_rgba(37,99,235,0.08),_transparent_60%)] dark:bg-[radial-gradient(circle_at_top,_rgba(37,99,235,0.15),_transparent_60%)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-x grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-2 lg:py-24">
    <div>
      <div
        class="badge bg-blue-50 text-primary ring-1 ring-inset ring-blue-200 dark:bg-blue-900/30 dark:text-blue-300 dark:ring-blue-800"
      >
        <Icon name="fa6-solid:certificate" aria-hidden="true" />
        <span>v{VERSION} · MIT licensed · {PROVIDER_COUNT} DNS providers · OIDC/SSO</span>
      </div>

      <h1
        id="hero-title"
        class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl lg:text-6xl"
      >
        Self-hosted certificate management <span class="gradient-text">you can audit.</span>
      </h1>

      <p class="mt-5 max-w-xl text-lg text-gray-600 dark:text-gray-300">
        CertMate issues and renews TLS certificates across {PROVIDER_COUNT} DNS
        providers and records every action in a tamper-evident, independently
        verifiable audit trail. MIT-licensed, with OIDC/SSO and a REST API + CLI.
        It runs on your infrastructure &mdash; your keys never leave it.
      </p>

      <div class="mt-8 grid grid-cols-3 gap-4 sm:gap-6">
        <div>
          <div class="text-3xl font-bold text-primary sm:text-4xl">{PROVIDER_COUNT}+</div>
          <div class="mt-1 text-sm text-gray-500 dark:text-gray-400">DNS Providers</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-primary sm:text-4xl">14</div>
          <div class="mt-1 text-sm text-gray-500 dark:text-gray-400">CA &amp; Storage Backends</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-primary sm:text-4xl">1.2k+</div>
          <div class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            <Icon name="fa6-solid:star" class="text-yellow-500" aria-hidden="true" /> GitHub Stars
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="https://demo.certmate.org"
          class="btn btn-primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="fa6-solid:play" aria-hidden="true" />
          Live demo
          <span class="sr-only">(opens in new tab)</span>
        </a>
        <a href="#installation" class="btn btn-secondary">
          <Icon name="fa6-solid:rocket" aria-hidden="true" />
          Get Started
        </a>
        <a href="/security" class="btn btn-secondary">
          <Icon name="fa6-solid:shield-halved" aria-hidden="true" />
          Security &amp; trust
        </a>
        <a
          href={GITHUB}
          class="btn btn-secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="fa6-brands:github" aria-hidden="true" />
          View on GitHub
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </div>
    </div>

    {/* Illustrative certmate-cli transcript. Real command names from
       clients/certmate-cli; the output lines are schematic examples, not a
       captured run — presented as an example, never as live product output. */}
    <div
      class="overflow-hidden rounded-xl border border-gray-200 bg-gray-950 shadow-2xl dark:border-gray-800"
      role="img"
      aria-label="Example certmate-cli session: install the CLI, issue a certificate, verify the audit trail, and check instance health."
    >
      <div class="flex items-center gap-2 border-b border-gray-800 bg-gray-900 px-4 py-2.5">
        <span class="h-3 w-3 rounded-full bg-red-500" aria-hidden="true"></span>
        <span class="h-3 w-3 rounded-full bg-yellow-500" aria-hidden="true"></span>
        <span class="h-3 w-3 rounded-full bg-green-500" aria-hidden="true"></span>
        <span class="ml-3 text-xs font-medium text-gray-400">certmate-cli &mdash; illustrative</span>
      </div>
      <pre class="overflow-x-auto whitespace-pre-wrap break-words p-4 text-xs leading-relaxed text-gray-100 font-mono sm:text-sm"><code><span class="text-emerald-400">$</span> <span class="text-gray-100">pip install certmate-cli</span>
<span class="text-emerald-400">$</span> <span class="text-gray-100">export CERTMATE_URL=https://certmate.example.com</span>
<span class="text-emerald-400">$</span> <span class="text-gray-100">certmate cert create app.example.com --dns cloudflare --wait</span>
<span class="text-gray-400">issued  app.example.com  Let's Encrypt  expires in 90d</span>
<span class="text-emerald-400">$</span> <span class="text-gray-100">certmate audit verify</span>
<span class="text-gray-400">PASS  chain intact · Ed25519 checkpoint verified</span>
<span class="text-emerald-400">$</span> <span class="text-gray-100">certmate health</span>
<span class="text-gray-400">ok  storage=local  scheduler=running</span><span class="animate-pulse">_</span></code></pre>
    </div>
  </div>
</section>
