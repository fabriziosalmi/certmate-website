---
import { updates } from '~/data/whats-new';
import { Icon } from 'astro-icon/components';
import UpdateRow from '~/components/UpdateRow.astro';

// Show the current release and link to the rest. The back-catalogue used to
// sit here in a <details>, kept in the DOM so it would be indexed; it was
// 5,267 of the home page's 7,508 words, so the page that says what CertMate
// is read mostly as version notes. It now has its own page, /changelog/.
const [latest, ...earlier] = updates;
---

<section class="border-b border-gray-200 py-20 dark:border-gray-800" aria-labelledby="whats-new-title">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="whats-new-title" class="section-title">
        <Icon name="fa6-solid:wand-sparkles" class="mr-2 text-amber-500" aria-hidden="true" />
        What's New in CertMate
      </h2>
      <p class="section-description">The latest release; the full history is in the changelog</p>
    </div>

    {/* Latest release, always visible. */}
    <ul class="mt-12 mx-auto max-w-5xl divide-y divide-gray-200 dark:divide-gray-800 border border-gray-200 dark:border-gray-800 rounded-xl overflow-hidden bg-white dark:bg-gray-900" role="list">
      <UpdateRow u={latest} />
    </ul>

    {earlier.length > 0 && (
      <p class="mt-4 text-center">
        <a
          href="/changelog/"
          class="inline-flex items-center gap-2 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 px-5 py-3 text-sm font-medium text-gray-700 dark:text-gray-200 transition-colors hover:bg-gray-50 dark:hover:bg-gray-800/50"
        >
          <Icon name="fa6-solid:clock-rotate-left" class="text-gray-400" aria-hidden="true" />
          Full release history ({earlier.length} earlier releases)
          <Icon name="fa6-solid:arrow-right" class="text-gray-400" aria-hidden="true" />
        </a>
      </p>
    )}
  </div>
</section>
