---
import { updates } from '~/data/whats-new';
import { Icon } from 'astro-icon/components';
import UpdateRow from '~/components/UpdateRow.astro';

// Show the current release inline; collapse the back-catalogue behind a
// disclosure so the changelog does not cost a full page of scroll right after
// the hero. Everything stays in the DOM (native <details>), so the release
// history is still fully indexed for SEO and reachable by anyone who wants it.
const [latest, ...earlier] = updates;
---

<section class="border-b border-gray-200 py-20 dark:border-gray-800" aria-labelledby="whats-new-title">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="whats-new-title" class="section-title">
        <Icon name="fa6-solid:wand-sparkles" class="mr-2 text-amber-500" aria-hidden="true" />
        What's New in CertMate
      </h2>
      <p class="section-description">The latest release, with the full history a click away</p>
    </div>

    {/* Latest release, always visible. */}
    <ul class="mt-12 mx-auto max-w-5xl divide-y divide-gray-200 dark:divide-gray-800 border border-gray-200 dark:border-gray-800 rounded-xl overflow-hidden bg-white dark:bg-gray-900" role="list">
      <UpdateRow u={latest} />
    </ul>

    {/* Earlier releases, collapsed by default. `group` + `group-open:` rotate
       the chevron and swap the label without any JavaScript. */}
    {earlier.length > 0 && (
      <details class="group mt-4 mx-auto max-w-5xl">
        <summary class="flex cursor-pointer list-none [&::-webkit-details-marker]:hidden items-center justify-center gap-2 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 px-5 py-3 text-sm font-medium text-gray-700 dark:text-gray-200 transition-colors hover:bg-gray-50 dark:hover:bg-gray-800/50">
          <Icon name="fa6-solid:clock-rotate-left" class="text-gray-400" aria-hidden="true" />
          <span class="group-open:hidden">Show earlier releases ({earlier.length})</span>
          <span class="hidden group-open:inline">Hide earlier releases</span>
          <Icon
            name="fa6-solid:chevron-down"
            class="text-gray-400 transition-transform duration-200 group-open:rotate-180"
            aria-hidden="true"
          />
        </summary>
        <ul class="mt-3 divide-y divide-gray-200 dark:divide-gray-800 border border-gray-200 dark:border-gray-800 rounded-xl overflow-hidden bg-white dark:bg-gray-900" role="list">
          {earlier.map((u) => <UpdateRow u={u} />)}
        </ul>
      </details>
    )}
  </div>
</section>
