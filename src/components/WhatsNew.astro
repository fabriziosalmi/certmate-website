---
import { updates } from '~/data/whats-new';

// Badge → Tailwind class mapping. Kept in one place so a future restyle
// edits one map instead of N callsites.
const badgeClasses: Record<string, string> = {
  milestone: 'bg-amber-100 text-amber-800 ring-amber-200 dark:bg-amber-900/30 dark:text-amber-300 dark:ring-amber-800',
  security: 'bg-red-100 text-red-800 ring-red-200 dark:bg-red-900/30 dark:text-red-300 dark:ring-red-800',
  fix: 'bg-blue-100 text-blue-800 ring-blue-200 dark:bg-blue-900/30 dark:text-blue-300 dark:ring-blue-800',
  feature: 'bg-emerald-100 text-emerald-800 ring-emerald-200 dark:bg-emerald-900/30 dark:text-emerald-300 dark:ring-emerald-800',
};
---

<section class="border-b border-gray-200 py-20 dark:border-gray-800" aria-labelledby="whats-new-title">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="whats-new-title" class="section-title">
        <i class="fas fa-sparkles mr-2 text-amber-500" aria-hidden="true"></i>
        What's New in CertMate
      </h2>
      <p class="section-description">Latest updates, improvements, and new features</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        updates.map((u) => {
          const CardTag = u.href ? 'a' : 'div';
          const wrap = u.href
            ? { href: u.href, target: '_blank', rel: 'noopener noreferrer' }
            : {};
          return (
            <CardTag
              {...wrap}
              class={`card group flex flex-col gap-3 ${u.highlight ? 'ring-2 ring-primary ring-offset-2 dark:ring-offset-gray-950' : ''}`}
            >
              <div class="flex items-center justify-between gap-2">
                <span class={`badge ring-1 ring-inset ${badgeClasses[u.badge]}`}>
                  <i class={`fas ${u.icon}`} aria-hidden="true" />
                  {u.badgeLabel}
                </span>
                <span class="text-xs text-gray-500 dark:text-gray-400">{u.date}</span>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{u.title}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-300">{u.description}</p>
              {u.href && (
                <span class="mt-1 text-xs font-medium text-primary inline-flex items-center gap-1">
                  Release notes
                  <i
                    class="fas fa-arrow-right transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none motion-reduce:transform-none"
                    aria-hidden="true"
                  />
                </span>
              )}
            </CardTag>
          );
        })
      }
    </div>
  </div>
</section>
