---
import { Icon } from 'astro-icon/components';
// Static counts (HN points, "1000+ stars") were rotting on this page —
// pinned-in-time numbers age into a "looks abandoned" signal. Each card
// now carries the ACTIVE social proof (a verb / a property) instead of a
// snapshot. The actual star count lives in one place (Hero) and is
// rotated on each release prep.
const items = [
  {
    href: 'https://github.com/fabriziosalmi/certmate',
    icon: 'fa6-brands:github',
    iconBg: 'bg-gray-900 dark:bg-gray-700',
    title: 'GitHub',
    meta: 'Active development · MIT licensed',
    sub: 'Source · issues · discussions',
  },
  {
    href: 'https://hub.docker.com/r/fabriziosalmi/certmate',
    icon: 'fa6-brands:docker',
    iconBg: 'bg-sky-600',
    title: 'Docker Hub',
    meta: 'Multi-platform · Auto-published',
    sub: 'linux/amd64 + linux/arm64',
  },
  {
    href: 'https://github.com/fabriziosalmi/certmate/discussions',
    icon: 'fa6-solid:comments',
    iconBg: 'bg-emerald-600',
    title: 'Discussions',
    meta: 'Q&A · feature ideas · show & tell',
    sub: 'GitHub Discussions',
  },
  {
    href: 'https://news.ycombinator.com/item?id=44427452',
    icon: 'fa6-brands:hacker-news',
    iconBg: 'bg-orange-500',
    title: 'Hacker News',
    meta: 'Past discussion',
    sub: 'Featured on Hacker News',
  },
];
---

<section class="border-b border-gray-200 py-20 dark:border-gray-800" aria-labelledby="community-title">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="community-title" class="section-title">
        <Icon name="fa6-solid:heart" class="mr-2 text-rose-500" aria-hidden="true" />
        Community & Featured
      </h2>
      <p class="section-description">
        Join our growing community and see where CertMate has been featured
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((i) => (
          <a
            href={i.href}
            class="card flex flex-col items-start gap-3"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class={`flex h-10 w-10 items-center justify-center rounded-lg text-white ${i.iconBg}`} aria-hidden="true">
              <Icon name={i.icon} />
            </div>
            <h3 class="text-base font-semibold text-gray-900 dark:text-white">{i.title}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-300">{i.meta}</p>
            <span class="text-xs font-medium text-gray-500 dark:text-gray-400">{i.sub}</span>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
