---
import { Icon } from 'astro-icon/components';
// Hero-style call-to-action band between the API and Documentation sections.
// Copy preserved from the static site.
---

<section class="border-b border-gray-200 bg-gradient-to-br from-blue-50 via-white to-cyan-50 py-20 dark:border-gray-800 dark:from-blue-950/30 dark:via-gray-950 dark:to-cyan-950/30">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="section-title">Ready to Secure Your Infrastructure?</h2>
      <p class="section-description">
        Join hundreds of developers and organizations using CertMate for their SSL certificate management
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="https://github.com/fabriziosalmi/certmate"
          class="btn btn-primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="fa6-brands:github" aria-hidden="true" />
          Get Started on GitHub
          <span class="sr-only">(opens in new tab)</span>
        </a>
        <a href="#docs" class="btn btn-secondary">
          <Icon name="fa6-solid:book" aria-hidden="true" />
          Read Documentation
        </a>
      </div>
    </div>
  </div>
</section>
