---
import { Icon } from 'astro-icon/components';
import { GITHUB } from '~/data/site';
// Hero-style call-to-action band between the API and Documentation sections.
// Copy is fact-only: no soft-number social proof (the previous "join
// hundreds of developers" line was unverifiable). The pitch is the honest
// self-hosting one — one command, and your keys never leave your box.
---

<section class="border-b border-gray-200 bg-gradient-to-br from-blue-50 via-white to-cyan-50 py-20 dark:border-gray-800 dark:from-blue-950/30 dark:via-gray-950 dark:to-cyan-950/30">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="section-title">Run it on your own infrastructure</h2>
      <p class="section-description">
        Self-host it in minutes: one <code class="rounded bg-white/60 px-1.5 py-0.5 font-mono text-[0.9em] dark:bg-gray-800">docker run</code> brings up the setup wizard on <code class="rounded bg-white/60 px-1.5 py-0.5 font-mono text-[0.9em] dark:bg-gray-800">localhost:8000</code>. Your certificates, private keys and audit trail stay on your box &mdash; nothing phones home.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={GITHUB}
          class="btn btn-primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="fa6-brands:github" aria-hidden="true" />
          Get Started on GitHub
          <span class="sr-only">(opens in new tab)</span>
        </a>
        <a href="#docs" class="btn btn-secondary">
          <Icon name="fa6-solid:book" aria-hidden="true" />
          Read Documentation
        </a>
      </div>
    </div>
  </div>
</section>
