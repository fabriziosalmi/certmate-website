---
import { Icon } from 'astro-icon/components';
// Three installation paths, ordered from "30 seconds to a running cert
// manager" to "full source build". The first tab is the single
// `docker run` command — the previous flow led with a `git clone` +
// edit-env dance, which is unnecessary friction for anyone who knows
// Docker. The compose-based flow remains under "Docker Compose"; the
// from-source flow under "Python".
const dockerOneShot = `# One command. Open http://localhost:8000 and follow the setup wizard.
docker run -d --name certmate \\
  -p 8000:8000 \\
  -v certmate-data:/app/data \\
  -v certmate-certs:/app/certificates \\
  --restart unless-stopped \\
  fabriziosalmi/certmate:latest

# Then open http://localhost:8000 and create the first admin
# in the setup wizard. No password is printed to the log.`;

const docker = `# Compose-based flow: useful when you want a single source of truth
# for env vars, volumes, and an optional nginx reverse proxy.
git clone https://github.com/fabriziosalmi/certmate.git
cd certmate

# Copy environment template
cp .env.example .env

# Edit .env with your DNS provider credentials
# Set API_BEARER_TOKEN and DNS provider settings

# Start all services
docker-compose up -d

# Check status
docker-compose ps`;

const python = `# Create virtual environment
python3 -m venv certmate-env
source certmate-env/bin/activate

# Clone and install
git clone https://github.com/fabriziosalmi/certmate.git
cd certmate
pip install -r requirements.txt

# Set environment variables
export API_BEARER_TOKEN="your_token_here"
export CLOUDFLARE_TOKEN="your_cloudflare_token"

# Run the application
python app.py`;

// No manifest ships in the repo, so the tab carries a real one inline
// rather than pointing at a k8s/deployment.yaml that does not exist.
// One replica on purpose: sessions, the scheduler and the rate limiter
// are single-instance state (see docs/kubernetes.md).
const k8s = `kubectl create namespace certmate

kubectl create secret generic certmate-secrets \\
  --from-literal=api-token=your_secure_token -n certmate

kubectl apply -n certmate -f - <<'YAML'
# Storage: the certificates and the settings/PKI state must survive a restart.
apiVersion: v1
kind: PersistentVolumeClaim
metadata: { name: certmate-data }
spec:
  accessModes: [ReadWriteOnce]
  resources: { requests: { storage: 1Gi } }
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata: { name: certmate-certs }
spec:
  accessModes: [ReadWriteOnce]
  resources: { requests: { storage: 1Gi } }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: certmate
spec:
  replicas: 1                 # single-instance: scheduler + in-memory sessions
  strategy: { type: Recreate }
  selector: { matchLabels: { app: certmate } }
  template:
    metadata: { labels: { app: certmate } }
    spec:
      containers:
        - name: certmate
          image: fabriziosalmi/certmate:latest
          ports: [{ containerPort: 8000 }]
          env:
            - name: API_BEARER_TOKEN
              valueFrom:
                secretKeyRef: { name: certmate-secrets, key: api-token }
          volumeMounts:
            - { name: data,  mountPath: /app/data }
            - { name: certs, mountPath: /app/certificates }
      volumes:
        - name: data
          persistentVolumeClaim: { claimName: certmate-data }
        - name: certs
          persistentVolumeClaim: { claimName: certmate-certs }
---
apiVersion: v1
kind: Service
metadata: { name: certmate }
spec:
  selector: { app: certmate }
  ports: [{ port: 8000, targetPort: 8000 }]
YAML

kubectl rollout status deploy/certmate -n certmate

# Reach the UI at http://localhost:8000 (add an Ingress for real access)
kubectl port-forward -n certmate svc/certmate 8000:8000`;

// The CLI installs the first-party terminal client (certmate-cli, on PyPI) —
// it drives an already-running instance over the REST API, it does not run
// the server itself.
const cli = `# certmate-cli — drive an existing CertMate instance from your terminal
pip install certmate-cli

# Point it at your instance (env vars are preferred over --token, which
# is visible to other local processes)
export CERTMATE_URL=https://certmate.example.com
export CERTMATE_TOKEN=your_api_token

# Issue a certificate and wait for it, then verify the audit trail
certmate cert create app.example.com --dns cloudflare --wait
certmate cert ls
certmate audit verify
certmate health`;

const tabs = [
  { id: 'docker-oneshot', label: 'docker run',     icon: 'fa6-brands:docker',       code: dockerOneShot },
  { id: 'docker',         label: 'Docker Compose', icon: 'fa6-brands:docker',       code: docker },
  { id: 'python',         label: 'Python',         icon: 'fa6-brands:python',       code: python },
  { id: 'kubernetes',     label: 'Kubernetes',     icon: 'fa6-solid:dharmachakra',  code: k8s },
  { id: 'cli',            label: 'CLI',            icon: 'fa6-solid:terminal',      code: cli },
];
---

<section id="installation" class="border-b border-gray-200 py-20 dark:border-gray-800" aria-labelledby="installation-title">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="installation-title" class="section-title">Quick Installation</h2>
      <p class="section-description">
        Single <code class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-sm dark:bg-gray-800">docker run</code> &mdash; the running container exposes the setup wizard on <code class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-sm dark:bg-gray-800">localhost:8000</code>, where you create the first admin. Compose, Python and Kubernetes paths below.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-3xl">
      <div class="flex gap-1 rounded-lg border border-gray-200 bg-gray-50 p-1 dark:border-gray-800 dark:bg-gray-900" role="tablist" aria-label="Installation methods">
        {
          tabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`${t.id}-tab`}
              aria-controls={t.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-tab={t.id}
              class={`tab-button flex-1 rounded-md px-3 py-2 text-sm font-medium transition-colors ${i === 0 ? 'bg-white text-gray-900 shadow-sm dark:bg-gray-700 dark:text-white' : 'text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white'}`}
            >
              <Icon name={t.icon} class="mr-1.5" aria-hidden="true" />
              {t.label}
            </button>
          ))
        }
      </div>

      <div class="mt-4">
        {
          tabs.map((t, i) => (
            <div
              id={t.id}
              role="tabpanel"
              aria-labelledby={`${t.id}-tab`}
              class={`tab-pane ${i === 0 ? '' : 'hidden'}`}
            >
              <div class="code-block">
                <div class="code-block-header">
                  <span>{t.label} Installation</span>
                  <button
                    class="copy-btn rounded p-1 text-gray-400 hover:bg-gray-800 hover:text-gray-200"
                    data-copy-target={`${t.id}-code`}
                    aria-label={`Copy ${t.label} installation code to clipboard`}
                  >
                    <Icon name="fa6-solid:copy" aria-hidden="true" />
                  </button>
                </div>
                <pre id={`${t.id}-code`}><code>{t.code}</code></pre>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Tab disclosure for the installation section.
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-button');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.tab;
      if (!targetId) return;

      // Update tab visuals + aria.
      buttons.forEach((b) => {
        const isActive = b === btn;
        b.setAttribute('aria-selected', String(isActive));
        b.classList.toggle('bg-white', isActive);
        b.classList.toggle('text-gray-900', isActive);
        b.classList.toggle('shadow-sm', isActive);
        b.classList.toggle('dark:bg-gray-700', isActive);
        b.classList.toggle('dark:text-white', isActive);
        b.classList.toggle('text-gray-600', !isActive);
        b.classList.toggle('hover:text-gray-900', !isActive);
        b.classList.toggle('dark:text-gray-400', !isActive);
        b.classList.toggle('dark:hover:text-white', !isActive);
      });

      // Toggle panels.
      document.querySelectorAll<HTMLElement>('.tab-pane').forEach((pane) => {
        pane.classList.toggle('hidden', pane.id !== targetId);
      });
    });
  });
</script>
