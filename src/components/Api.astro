---
import { Icon } from 'astro-icon/components';
const endpoints = [
  { method: 'POST', path: '/api/certificates/create',                       desc: 'Create new SSL certificate with account selection' },
  { method: 'POST', path: '/api/dns/{provider}/accounts',                   desc: 'Add new DNS provider account' },
  { method: 'GET',  path: '/api/certificates',                              desc: 'List all certificates with account info' },
  { method: 'GET',  path: '/api/certificates/{domain}/download',            desc: 'Download certificate bundle (ZIP)' },
];

const example = `# Add multiple DNS accounts
curl -X POST "https://certmate.example.com/api/dns/cloudflare/accounts" \\
  -H "Authorization: Bearer your_api_token_here" \\
  -H "Content-Type: application/json" \\
  -d '{"account_id": "production", "config": {"api_token": "prod_token"}}'

# Create certificate with specific account
curl -X POST "https://certmate.example.com/api/certificates/create" \\
  -H "Authorization: Bearer your_api_token_here" \\
  -H "Content-Type: application/json" \\
  -d '{"domain": "api.company.com", "dns_provider": "cloudflare", "account_id": "production"}'

# Download certificate
curl -H "Authorization: Bearer your_api_token_here" \\
     -o api.company.com-tls.zip \\
     "https://certmate.example.com/api/certificates/api.company.com/download"`;

// The same surface from the terminal, via the first-party certmate-cli
// (built on certmate-sdk; both on PyPI). Real subcommands from
// clients/certmate-cli.
const cliExample = `# Install once
pip install certmate-cli
export CERTMATE_URL=https://certmate.example.com
export CERTMATE_TOKEN=your_api_token

# Issue, list, and verify the tamper-evident audit trail
certmate cert create api.company.com --dns cloudflare --wait
certmate cert ls
certmate audit verify

# Or, from Python
python -c "from certmate import Client; print(Client().list_certificates())"`;

const methodColors: Record<string, string> = {
  GET:  'bg-emerald-100 text-emerald-800 ring-emerald-200 dark:bg-emerald-900/30 dark:text-emerald-300 dark:ring-emerald-800',
  POST: 'bg-blue-100 text-blue-800 ring-blue-200 dark:bg-blue-900/30 dark:text-blue-300 dark:ring-blue-800',
};
---

<section id="api" class="border-b border-gray-200 py-20 dark:border-gray-800">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="section-title">REST API + CLI</h2>
      <p class="section-description">
        Drive every certificate operation over HTTP, or from the terminal with the first-party CLI and Python SDK.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        endpoints.map((e) => (
          <div class="card flex flex-col gap-2">
            <span class={`badge ring-1 ring-inset self-start font-mono ${methodColors[e.method]}`}>{e.method}</span>
            <code class="text-sm text-gray-900 dark:text-gray-100">{e.path}</code>
            <p class="text-sm text-gray-600 dark:text-gray-300">{e.desc}</p>
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-10 max-w-3xl">
      <div class="code-block">
        <div class="code-block-header">
          <span>API Example</span>
          <button
            class="copy-btn rounded p-1 text-gray-400 hover:bg-gray-800 hover:text-gray-200"
            data-copy-target="api-example"
            aria-label="Copy API example code to clipboard"
          >
            <Icon name="fa6-solid:copy" aria-hidden="true" />
          </button>
        </div>
        <pre id="api-example"><code>{example}</code></pre>
      </div>
    </div>

    <div class="mx-auto mt-6 max-w-3xl">
      <div class="code-block">
        <div class="code-block-header">
          <span>Same surface from the terminal (certmate-cli)</span>
          <button
            class="copy-btn rounded p-1 text-gray-400 hover:bg-gray-800 hover:text-gray-200"
            data-copy-target="cli-example"
            aria-label="Copy CLI example code to clipboard"
          >
            <Icon name="fa6-solid:copy" aria-hidden="true" />
          </button>
        </div>
        <pre id="cli-example"><code>{cliExample}</code></pre>
      </div>
    </div>

    <p class="mt-6 text-center text-sm text-gray-500 dark:text-gray-400">
      Full Swagger/OpenAPI docs ship at <code>/docs/</code> on any running instance;
      <code>certmate-cli</code> and <code>certmate-sdk</code> are on PyPI.
    </p>
  </div>
</section>

<script>
  // Wire up every copy button on the page. Used by Enterprise, Installation, Api.
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const targetId = btn.dataset.copyTarget;
      if (!targetId) return;
      const target = document.getElementById(targetId);
      if (!target) return;
      try {
        await navigator.clipboard.writeText(target.textContent ?? '');
        const icon = btn.querySelector('i');
        if (icon) {
          icon.classList.remove('fa-copy');
          icon.classList.add('fa-check', 'text-emerald-400');
          setTimeout(() => {
            icon.classList.add('fa-copy');
            icon.classList.remove('fa-check', 'text-emerald-400');
          }, 1500);
        }
      } catch (_) {
        /* clipboard API blocked — no UI affordance available */
      }
    });
  });
</script>
