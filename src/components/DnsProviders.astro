---
import { Icon } from 'astro-icon/components';
// Canonical provider list pulled from modules/core/utils.py
// (_DNS_PROVIDER_CREDENTIALS) — every name on this grid corresponds to
// a provider CertMate can issue against today. Listed in roughly the
// order they ship in the codebase so a contributor reading the source
// recognises the layout.
//
// Provider names with a known brand glyph in Font Awesome use it;
// long-tail providers use a neutral globe so the grid stays uniform.
// The cell is intentionally compact (icon + name + short note) — a
// visitor scanning for "do you support X?" needs to find their
// provider in 2 seconds, not read a paragraph about each one.

const providers = [
  { icon: 'fa6-brands:cloudflare',    name: 'Cloudflare',         note: 'multi-account' },
  { icon: 'fa6-brands:aws',           name: 'AWS Route53',        note: 'multi-account' },
  { icon: 'fa6-brands:microsoft',     name: 'Azure DNS',          note: 'multi-subscription' },
  { icon: 'fa6-brands:google',        name: 'Google Cloud DNS',   note: 'multi-account' },
  { icon: 'fa6-brands:digital-ocean', name: 'DigitalOcean',       note: 'multi-account' },
  { icon: 'fa6-solid:server',         name: 'PowerDNS',           note: 'self-hosted' },
  { icon: 'fa6-solid:cube',           name: 'Linode',             note: 'multi-account' },
  { icon: 'fa6-solid:leaf',           name: 'Gandi',              note: 'EU registrar' },
  { icon: 'fa6-solid:globe',          name: 'OVH',                note: 'EU cloud' },
  { icon: 'fa6-solid:tag',            name: 'Namecheap',          note: 'registrar' },
  { icon: 'fa6-solid:cloud',          name: 'ArvanCloud',         note: 'multi-account' },
  { icon: 'fa6-solid:mountain',       name: 'Infomaniak',         note: 'EU cloud' },
  { icon: 'fa6-solid:shield-halved',  name: 'ACME-DNS',           note: 'CNAME delegation' },
  { icon: 'fa6-solid:feather',        name: 'DuckDNS',            note: 'free dynamic DNS' },
  { icon: 'fa6-solid:server',         name: 'Vultr',              note: 'multi-account' },
  { icon: 'fa6-solid:bolt',           name: 'DNS Made Easy',      note: 'multi-account' },
  { icon: 'fa6-solid:circle',         name: 'NS1',                note: 'managed DNS' },
  { icon: 'fa6-solid:h',              name: 'Hetzner DNS',        note: 'EU hosting' },
  { icon: 'fa6-solid:server',         name: 'Hetzner Cloud',      note: 'EU hosting' },
  { icon: 'fa6-solid:piggy-bank',     name: 'Porkbun',            note: 'registrar' },
  { icon: 'fa6-solid:golf-ball-tee',  name: 'GoDaddy',            note: 'registrar' },
  { icon: 'fa6-solid:network-wired',  name: 'Hurricane Electric', note: 'free DDNS' },
  { icon: 'fa6-solid:d',              name: 'Dynu DNS',           note: 'dynamic DNS' },
  { icon: 'fa6-solid:network-wired',  name: 'Akamai EdgeDNS',     note: 'enterprise CDN' },
];
---

<section id="providers" class="border-b border-gray-200 py-20 dark:border-gray-800">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="section-title">Supported DNS Providers</h2>
      <p class="section-description">
        24 DNS providers in the box today, plus multi-account support per provider for staging / production / multi-region isolation.
      </p>
    </div>

    <ul
      class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6"
      role="list"
      aria-label="DNS providers supported by CertMate"
    >
      {
        providers.map((p) => (
          <li
            role="listitem"
            class="flex items-center gap-2.5 rounded-lg border border-gray-200 bg-white px-3 py-2.5 dark:border-gray-800 dark:bg-gray-900"
          >
            <Icon name={p.icon} class="text-base text-primary flex-shrink-0 w-4 text-center" aria-hidden="true" />
            <div class="min-w-0">
              <div class="truncate text-xs font-semibold text-gray-900 dark:text-white sm:text-sm">
                {p.name}
              </div>
              <div class="truncate text-[0.65rem] text-gray-500 dark:text-gray-400 sm:text-xs">
                {p.note}
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-center text-sm text-gray-500 dark:text-gray-400">
      Missing yours? <a
        class="font-medium text-primary hover:underline"
        href="https://github.com/fabriziosalmi/certmate/issues/new?labels=enhancement&amp;title=DNS+provider%3A+"
        target="_blank"
        rel="noopener noreferrer"
      >Open a request</a>
      &mdash; the strategy registry in
      <code>modules/core/dns_strategies.py</code>
      makes adding a provider a ~50-line patch.
      <a
        class="font-medium text-primary hover:underline"
        href="https://github.com/fabriziosalmi/certmate/wiki/DNS-Providers"
        target="_blank"
        rel="noopener noreferrer"
      >Full credential reference</a>
      on the wiki.
    </p>
  </div>
</section>
