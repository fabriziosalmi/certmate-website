---
import { Icon } from 'astro-icon/components';
// Footer copy preserved verbatim from the static site. The "Made with"
// line previously rendered with a heart emoji glyph; we use a Font
// Awesome icon instead so the rendering is identical on every OS and
// assistive tech does not announce a stray emoji name.
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-900/40">
  <div class="container-x py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2.5">
          <img
            src="/assets/certmate_logo.png"
            alt="CertMate logo"
            class="h-9 w-9"
            width="36"
            height="36"
            loading="lazy"
            decoding="async"
          />
          <span class="text-lg font-bold tracking-tight">CertMate</span>
        </div>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-300">
          Open-source SSL certificate management system for modern infrastructure
        </p>
        <div class="mt-4 flex items-center gap-3">
          <a
            href="https://github.com/fabriziosalmi/certmate"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="CertMate on GitHub"
            class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
          >
            <Icon name="fa6-brands:github" class="text-xl" aria-hidden="true" />
          </a>
          <a
            href="https://hub.docker.com/r/fabriziosalmi/certmate"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="CertMate on Docker Hub"
            class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
          >
            <Icon name="fa6-brands:docker" class="text-xl" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-gray-900 dark:text-white">Product</h4>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/#features"     class="text-gray-600 hover:text-primary dark:text-gray-400">Features</a></li>
          <li><a href="/#providers"    class="text-gray-600 hover:text-primary dark:text-gray-400">DNS Providers</a></li>
          <li><a href="/#installation" class="text-gray-600 hover:text-primary dark:text-gray-400">Installation</a></li>
          <li><a href="/#api"          class="text-gray-600 hover:text-primary dark:text-gray-400">API</a></li>
          <li><a href="/cert-manager-alternative" class="text-gray-600 hover:text-primary dark:text-gray-400">Compare alternatives</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-gray-900 dark:text-white">Resources</h4>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a
              href="https://github.com/fabriziosalmi/certmate/blob/main/README.md"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-600 hover:text-primary dark:text-gray-400"
            >Documentation</a>
          </li>
          <li>
            <a href="/docs/getting-started.html" class="text-gray-600 hover:text-primary dark:text-gray-400">
              Installation Guide
            </a>
          </li>
          <li>
            <a href="/errors" class="text-gray-600 hover:text-primary dark:text-gray-400">
              SSL Error Reference
            </a>
          </li>
          <li>
            <a href="/deploy" class="text-gray-600 hover:text-primary dark:text-gray-400">
              Deploy Guides
            </a>
          </li>
          <li>
            <a
              href="https://github.com/fabriziosalmi/certmate/issues"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-600 hover:text-primary dark:text-gray-400"
            >Support</a>
          </li>
          <li>
            <a
              href="https://github.com/fabriziosalmi/certmate/blob/main/CONTRIBUTING.md"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-600 hover:text-primary dark:text-gray-400"
            >Contributing</a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-gray-900 dark:text-white">Legal</h4>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a
              href="https://github.com/fabriziosalmi/certmate/blob/main/LICENSE"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-600 hover:text-primary dark:text-gray-400"
            >MIT License</a>
          </li>
          <li>
            <a
              href="https://github.com/fabriziosalmi/certmate/blob/main/CODE_OF_CONDUCT.md"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-600 hover:text-primary dark:text-gray-400"
            >Code of Conduct</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center gap-2 border-t border-gray-200 pt-6 text-sm text-gray-500 dark:border-gray-800 dark:text-gray-400 sm:flex-row sm:justify-between">
      <p>&copy; {year} CertMate. Licensed under MIT License.</p>
      <p>
        Built by
        <a
          href="https://github.com/fabriziosalmi"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-gray-700 hover:text-primary dark:text-gray-300"
        >Fabrizio Salmi</a>
        and
        <a
          href="https://github.com/fabriziosalmi/certmate/graphs/contributors"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-gray-700 hover:text-primary dark:text-gray-300"
        >contributors</a>.
      </p>
    </div>
  </div>
</footer>
