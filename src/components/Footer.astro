---
import { Icon } from 'astro-icon/components';
import { ui, localizedPath, type Locale } from '~/i18n';

interface Props {
  /**
   * The language of the page this footer sits on.
   *
   * It had none, and was called as `<Footer />` from all four call sites,
   * including DocLayout which knows the locale perfectly well. So the footer
   * was English on every page including the 20 Italian ones, and its "SSL
   * Error Reference" link sent an Italian reader to the English index.
   */
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];

/**
 * Pages that exist in English only.
 *
 * Localising every href blindly is what the first version of this did, and
 * scripts/check-seo.mjs refused it with 60 dead links: /it/privacy/,
 * /it/security/ and /it/docs/getting-started.html are not pages. The label
 * stays translated, because the reader still needs to know what the link is;
 * the address stays English, because that is where the page is. An English
 * page is a worse answer than an Italian one and a much better answer than a
 * 404.
 *
 * When one of these gains an Italian version, delete it from here and the
 * link follows.
 */
// The trailing slash is load-bearing: /privacy, /security and
// /cert-manager-alternative are all 301s without it, verified against the
// live site. localizedPath() adds it for the paths it handles; these carry
// it themselves.
const ENGLISH_ONLY = new Set(['/privacy/', '/security/', '/docs/getting-started.html']);

// The one class every footer link wears. Inline it eight times and the
// lines run past 120 characters, which is what the long-line check was
// reporting; the content is not the length.
const LINK = 'text-gray-600 hover:text-primary dark:text-gray-400';

const path = (to: string) =>
  ENGLISH_ONLY.has(to) ? to : localizedPath(lang, to);

// Footer copy preserved verbatim from the static site. The "Made with"
// line previously rendered with a heart emoji glyph; we use a Font
// Awesome icon instead so the rendering is identical on every OS and
// assistive tech does not announce a stray emoji name.
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-900/40">
  <div class="container-x py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2.5">
          <img
            src="/assets/certmate_logo.png"
            alt="CertMate logo"
            class="h-9 w-9"
            width="36"
            height="36"
            loading="lazy"
            decoding="async"
          />
          <span class="text-lg font-bold tracking-tight">CertMate</span>
        </div>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-300">
          {t.footerTagline}
        </p>
        <div class="mt-4 flex items-center gap-3">
          <a
            href="https://github.com/fabriziosalmi/certmate"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="CertMate on GitHub"
            class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
          >
            <Icon name="fa6-brands:github" class="text-xl" aria-hidden="true" />
          </a>
          <a
            href="https://hub.docker.com/r/fabriziosalmi/certmate"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="CertMate on Docker Hub"
            class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
          >
            <Icon name="fa6-brands:docker" class="text-xl" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-gray-900 dark:text-white">{t.footerProduct}</h4>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={path('/#features')}     class={LINK}>{t.footerFeatures}</a></li>
          <li><a href={path('/#providers')}    class={LINK}>{t.footerProviders}</a></li>
          <li><a href={path('/#installation')} class={LINK}>{t.footerInstallation}</a></li>
          <li><a href={path('/#api')}          class={LINK}>{t.footerApi}</a></li>
          <li><a href={path('/security/')}      class={LINK}>{t.footerSecurity}</a></li>
          <li><a href={path('/cert-manager-alternative/')} class={LINK}>{t.footerCompare}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-gray-900 dark:text-white">{t.footerResources}</h4>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a
              href="https://github.com/fabriziosalmi/certmate/blob/main/README.md"
              target="_blank"
              rel="noopener noreferrer"
              class={LINK}
            >{t.footerDocumentation}</a>
          </li>
          <li>
            <a href={path('/docs/getting-started.html')} class={LINK}>{t.footerInstallGuide}</a>
          </li>
          <li>
            <a href={path('/errors/')} class={LINK}>{t.footerErrors}</a>
          </li>
          <li>
            <a href={path('/deploy/')} class={LINK}>{t.footerDeploy}</a>
          </li>
          <li>
            <a
              href="https://github.com/fabriziosalmi/certmate/issues"
              target="_blank"
              rel="noopener noreferrer"
              class={LINK}
            >{t.footerSupport}</a>
          </li>
          <li>
            <a
              href="https://github.com/fabriziosalmi/certmate/blob/main/CONTRIBUTING.md"
              target="_blank"
              rel="noopener noreferrer"
              class={LINK}
            >{t.footerContributing}</a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-gray-900 dark:text-white">{t.footerLegal}</h4>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a
              href="https://github.com/fabriziosalmi/certmate/blob/main/LICENSE"
              target="_blank"
              rel="noopener noreferrer"
              class={LINK}
            >{t.footerLicense}</a>
          </li>
          <li>
            <a
              href="https://github.com/fabriziosalmi/certmate/blob/main/CODE_OF_CONDUCT.md"
              target="_blank"
              rel="noopener noreferrer"
              class={LINK}
            >{t.footerConduct}</a>
          </li>
          <li>
            <a href={path('/privacy/')} class={LINK}>{t.footerPrivacy}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center gap-2 border-t border-gray-200 pt-6 text-sm text-gray-500 dark:border-gray-800 dark:text-gray-400 sm:flex-row sm:justify-between">
      <p>&copy; {year} CertMate. {t.footerLicensed}</p>
      <p>
        {t.footerBuiltBy}
        <a
          href="https://github.com/fabriziosalmi"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-gray-700 hover:text-primary dark:text-gray-300"
        >Fabrizio Salmi</a>
        {t.footerAnd}
        <a
          href="https://github.com/fabriziosalmi/certmate/graphs/contributors"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-gray-700 hover:text-primary dark:text-gray-300"
        >{t.footerContributors}</a>.
      </p>
    </div>
  </div>
</footer>
