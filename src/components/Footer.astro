---
import { Icon } from 'astro-icon/components';
import { FOOTER_BLURB, FOOTER_COLUMNS, FOOTER_CREDITS, FOOTER_SOCIAL_LINKS } from '~/data/nav';
// The columns live in src/data/nav.ts, which the documentation pages render
// from too.
const year = new Date().getFullYear();
// min-h-6: 24px rows, the WCAG 2.2 minimum target size, instead of 17px.
const linkClass = 'inline-flex min-h-6 min-w-6 items-center text-gray-600 hover:text-primary dark:text-gray-400';
---

<footer class="border-t border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-900/40">
  <div class="container-x py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2.5">
          <img
            src="/assets/certmate_logo.png"
            alt=""
            class="h-9 w-9"
            width="36"
            height="36"
            loading="lazy"
            decoding="async"
          />
          <span class="text-lg font-bold tracking-tight">CertMate</span>
        </div>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-300">{FOOTER_BLURB}</p>
        <div class="mt-4 flex items-center gap-1">
          {FOOTER_SOCIAL_LINKS.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="inline-flex h-11 w-11 items-center justify-center rounded-md text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
            >
              <Icon name={s.icon} class="text-xl" aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>

      {FOOTER_COLUMNS.map((col) => (
        <div>
          <h2 class="text-sm font-semibold text-gray-900 dark:text-white">{col.title}</h2>
          <ul class="mt-3 space-y-1 text-sm">
            {col.links.map((l) => (
              <li>
                {l.external ? (
                  <a href={l.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
                    {l.label}<span class="sr-only"> (opens in new tab)</span>
                  </a>
                ) : (
                  <a href={l.href} hreflang={l.hreflang} lang={l.hreflang} class={linkClass}>{l.label}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-center gap-2 border-t border-gray-200 pt-6 text-sm text-gray-600 dark:border-gray-800 dark:text-gray-400 sm:flex-row sm:justify-between">
      <p>&copy; {year} CertMate. Licensed under MIT License.</p>
      <p>
        Built by
        <a href={FOOTER_CREDITS.author.href} target="_blank" rel="noopener noreferrer" class="font-medium text-gray-700 underline decoration-gray-300 underline-offset-2 hover:text-primary dark:text-gray-300 dark:decoration-gray-600">{FOOTER_CREDITS.author.label}</a>
        and
        <a href={FOOTER_CREDITS.contributors.href} target="_blank" rel="noopener noreferrer" class="font-medium text-gray-700 underline decoration-gray-300 underline-offset-2 hover:text-primary dark:text-gray-300 dark:decoration-gray-600">{FOOTER_CREDITS.contributors.label}</a>.
      </p>
    </div>
  </div>
</footer>
