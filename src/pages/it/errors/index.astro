---
import DocLayout from '~/layouts/DocLayout.astro';
import ErrorsIndex from '~/components/ErrorsIndex.astro';
import { ui } from '~/i18n';

const t = ui.it;
---

<DocLayout lang="it" path="/errors" title={t.errorsTitle} description={t.errorsDescription}>
  <h1>{t.errorsTitle}</h1>
  <p class="lead">{t.errorsIntro}</p>

  <ErrorsIndex lang="it" />
</DocLayout>
