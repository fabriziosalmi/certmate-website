---
import { getCollection, render } from 'astro:content';
import DocLayout from '~/layouts/DocLayout.astro';
import { ui } from '~/i18n';

export async function getStaticPaths() {
  const all = await getCollection('errors');
  return all
    .filter((e) => e.id.startsWith('it/'))
    .map((e) => ({ params: { slug: e.id.replace(/^it\//, '') }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const t = ui.it;
const slug = entry.id.replace(/^it\//, '');
const path = `/errors/${slug}`;
const d = entry.data;
---

<DocLayout
  lang="it"
  path={path}
  title={d.title}
  headTitle={`${d.errorCode}${t.errorTitleTail}`}
  description={d.description}
  media={d.media}
  breadcrumbs={[{ label: t.errors, path: '/errors' }]}
>
  <h1 class="break-words"><code class="font-mono text-red-700 before:content-none after:content-none dark:text-red-300">{d.errorCode}</code>{t.errorHeadingTail}</h1>
  <p class="lead">{d.summary}</p>
  {(d.browsers.length > 0 || d.updated) && (
    <p class="not-prose mb-6 text-xs text-gray-500 dark:text-gray-400">
      {d.browsers.length > 0 && <>{t.affectedBrowsers}: {d.browsers.join(', ')}</>}
      {d.updated && <> · {t.updated}{' '}{d.updated}</>}
    </p>
  )}
  <Content />
</DocLayout>
