---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import DocLayout from '~/layouts/DocLayout.astro';
import { ui, localizedPath } from '~/i18n';

const t = ui.en;
const entries = (await getCollection('deploy'))
  .filter((e) => e.id.startsWith('en/'))
  .sort((a, b) => a.data.order - b.data.order);
---

<DocLayout lang="en" path="/deploy" title={t.deployTitle} description={t.deployIntro}>
  <h1>{t.deployTitle}</h1>
  <p class="lead">{t.deployIntro}</p>

  <ul class="not-prose mt-8 grid gap-3 sm:grid-cols-2">
    {entries.map((e) => (
      <li>
        <a
          href={localizedPath('en', `/deploy/${e.id.replace(/^en\//, '')}`)}
          class="flex h-full items-start gap-3 rounded-lg border border-gray-200 p-4 transition-colors hover:border-primary dark:border-gray-700"
        >
          <Icon name={e.data.icon} class="mt-0.5 text-xl text-primary" />
          <span>
            <span class="font-semibold text-gray-900 dark:text-white">{e.data.platform}</span>
            <span class="mt-1 block text-sm text-gray-600 dark:text-gray-300">{e.data.summary}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</DocLayout>
