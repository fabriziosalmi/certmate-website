---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Navbar from '~/components/Navbar.astro';
import Footer from '~/components/Footer.astro';
import UpdateRow from '~/components/UpdateRow.astro';
import { updates } from '~/data/whats-new';

// The release history, on a page of its own.
//
// It used to live on the home page, collapsed behind a <details> and kept in
// the DOM so it would still be indexed. Measured on the live site, that made
// it 5,267 of the home page's 7,508 words: seventy per cent of the page that
// is supposed to say what CertMate is was version notes. Here it is the whole
// subject of the page, which is what someone looking for the changelog wants,
// and the home page keeps the latest release and a link.
//
// Same data, same rows, no text written for this page beyond the heading and
// the description: every card is still the one src/data/whats-new.ts holds.
const title = 'Changelog — CertMate release history';
const description =
  'Every CertMate release, newest first: what each version added, fixed or hardened, with links to the full release notes on GitHub.';
const canonical = 'https://www.certmate.org/changelog/';
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Navbar />
  <main id="main-content" class="flex-1">
    <section class="container-x py-16">
      <div class="mx-auto max-w-5xl">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
          CertMate changelog
        </h1>
        <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-300 leading-relaxed">
          Every release, newest first. Each entry summarises what changed; where
          a release has published notes, the entry links to them on GitHub.
        </p>

        <ul class="mt-10 divide-y divide-gray-200 dark:divide-gray-800 border border-gray-200 dark:border-gray-800 rounded-xl overflow-hidden bg-white dark:bg-gray-900" role="list">
          {updates.map((u) => <UpdateRow u={u} level={2} />)}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
