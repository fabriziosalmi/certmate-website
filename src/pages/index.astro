---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Navbar from '~/components/Navbar.astro';
import Hero from '~/components/Hero.astro';
import WhatsNew from '~/components/WhatsNew.astro';
import Features from '~/components/Features.astro';
import Comparison from '~/components/Comparison.astro';
import Ecosystem from '~/components/Ecosystem.astro';
import Community from '~/components/Community.astro';
import DnsProviders from '~/components/DnsProviders.astro';
import Enterprise from '~/components/Enterprise.astro';
import Installation from '~/components/Installation.astro';
import Api from '~/components/Api.astro';
import Cta from '~/components/Cta.astro';
import Docs from '~/components/Docs.astro';
import Footer from '~/components/Footer.astro';
---

<BaseLayout>
  <Navbar />
  <main id="main-content" class="flex-1">
    <Hero />
    <WhatsNew />
    <Features />
    <Comparison />
    <Ecosystem />
    <Community />
    <DnsProviders />
    <Enterprise />
    <Installation />
    <Api />
    <Cta />
    <Docs />
  </main>
  <Footer />
</BaseLayout>
