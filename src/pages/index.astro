---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { alternatesFor } from '~/i18n';
import Navbar from '~/components/Navbar.astro';
import Hero from '~/components/Hero.astro';
import WhatsNew from '~/components/WhatsNew.astro';
import Features from '~/components/Features.astro';
import Screenshots from '~/components/Screenshots.astro';
import Comparison from '~/components/Comparison.astro';
import Ecosystem from '~/components/Ecosystem.astro';
import Community from '~/components/Community.astro';
import DnsProviders from '~/components/DnsProviders.astro';
import Enterprise from '~/components/Enterprise.astro';
import Installation from '~/components/Installation.astro';
import Api from '~/components/Api.astro';
import Cta from '~/components/Cta.astro';
import Docs from '~/components/Docs.astro';
import Footer from '~/components/Footer.astro';
---

<!-- alternates: /it/ declared this page as its English alternate and got
     nothing back. Google ignores an annotation that is not reciprocated
     ("If two pages don't both point to each other, the tags will be
     ignored"), so the Italian home was not connected to this one at all. -->
<BaseLayout alternates={alternatesFor('/')}>
  <Navbar />
  <main id="main-content" class="flex-1">
    <Hero />
    <WhatsNew />
    <Features />
    <Screenshots />
    <Comparison />
    <Ecosystem />
    <Community />
    <DnsProviders />
    <Enterprise />
    <Installation />
    <Api />
    <Cta />
    <Docs />
  </main>
  <Footer />
</BaseLayout>
