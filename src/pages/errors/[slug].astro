---
import { getCollection, render } from 'astro:content';
import DocLayout from '~/layouts/DocLayout.astro';
import { ui } from '~/i18n';

export async function getStaticPaths() {
  const all = await getCollection('errors');
  return all
    .filter((e) => e.id.startsWith('en/'))
    .map((e) => ({ params: { slug: e.id.replace(/^en\//, '') }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const t = ui.en;
const slug = entry.id.replace(/^en\//, '');
const path = `/errors/${slug}`;
const d = entry.data;
---

<DocLayout
  lang="en"
  path={path}
  title={d.title}
  description={d.description}
  breadcrumbs={[{ label: t.errors, path: '/errors' }]}
>
  <p class="not-prose mb-4 inline-block rounded bg-red-50 px-3 py-1 font-mono text-sm text-red-700 dark:bg-red-900/20 dark:text-red-300">{d.errorCode}</p>
  <p class="lead">{d.summary}</p>
  {(d.browsers.length > 0 || d.updated) && (
    <p class="not-prose mb-6 text-xs text-gray-500 dark:text-gray-400">
      {d.browsers.length > 0 && <>{t.affectedBrowsers}: {d.browsers.join(', ')}</>}
      {d.updated && <> · {t.updated} {d.updated}</>}
    </p>
  )}
  <Content />
</DocLayout>
